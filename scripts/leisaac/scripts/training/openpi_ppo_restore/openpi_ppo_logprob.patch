diff --git a/scripts/train_fast_ppo_rollouts.py b/scripts/train_fast_ppo_rollouts.py
new file mode 100644
index 0000000..c88d930
--- /dev/null
+++ b/scripts/train_fast_ppo_rollouts.py
@@ -0,0 +1,399 @@
+"""Single-process PPO finetuning for pi0-FAST rollouts.
+
+This learner consumes rollout ``.npz`` files from LeIsaac that include sampled
+FAST action tokens and behavior-policy token logprobs. It intentionally avoids
+Ray, shared-memory IPC, and simulator workers: rollouts are file handoffs and
+the update is a normal OpenPI/JAX training process.
+"""
+
+from __future__ import annotations
+
+import argparse
+import dataclasses
+import functools
+import json
+import logging
+from pathlib import Path
+from typing import Any
+
+import flax.nnx as nnx
+import jax
+import jax.numpy as jnp
+import numpy as np
+import optax
+import orbax.checkpoint as ocp
+import tqdm_loggable.auto as tqdm
+
+import openpi.models.model as _model
+import openpi.shared.array_typing as at
+import openpi.shared.download as download
+import openpi.shared.normalize as _normalize
+import openpi.transforms as _transforms
+import openpi.training.config as _config
+import openpi.training.utils as training_utils
+
+
+LOGGER = logging.getLogger("openpi.fast_ppo")
+IMAGE_SHAPE = (224, 224, 3)
+
+
+@dataclasses.dataclass(frozen=True)
+class PPOExample:
+    state: np.ndarray
+    action_tokens: np.ndarray
+    old_token_logprobs: np.ndarray
+    action_token_mask: np.ndarray
+    advantage: float
+    prompt: str
+    front_image: np.ndarray
+    wrist_image: np.ndarray
+
+
+def parse_args() -> argparse.Namespace:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--config", default="pi0_fast_so101_lift_cube")
+    parser.add_argument("--rollout_dir", type=Path, required=True)
+    parser.add_argument("--init_checkpoint", default=None)
+    parser.add_argument("--save_dir", type=Path, default=None)
+    parser.add_argument("--num_train_steps", type=int, default=1)
+    parser.add_argument("--batch_size", type=int, default=1)
+    parser.add_argument("--learning_rate", type=float, default=1e-6)
+    parser.add_argument("--seed", type=int, default=0)
+    parser.add_argument("--gamma", type=float, default=0.99)
+    parser.add_argument("--clip_epsilon", type=float, default=0.2)
+    parser.add_argument("--kl_coef", type=float, default=0.0)
+    parser.add_argument("--logprob_temperature", type=float, default=1.0)
+    parser.add_argument("--max_examples", type=int, default=512)
+    parser.add_argument("--make_smoke_rollout", action="store_true")
+    parser.add_argument("--dry_run_data", action="store_true")
+    parser.add_argument("--init_random", action="store_true")
+    return parser.parse_args()
+
+
+def discounted_returns(rewards: np.ndarray, gamma: float) -> np.ndarray:
+    returns = np.zeros_like(rewards, dtype=np.float32)
+    running = 0.0
+    for index in range(len(rewards) - 1, -1, -1):
+        running = float(rewards[index]) + gamma * running
+        returns[index] = running
+    return returns
+
+
+def rollout_prompt(data: np.lib.npyio.NpzFile) -> str:
+    if "meta_json" not in data:
+        return "Lift the red cube up."
+    meta = json.loads(str(data["meta_json"].item()))
+    return str(meta.get("prompt") or "Lift the red cube up.")
+
+
+def make_smoke_rollout(rollout_dir: Path, *, action_dim: int, token_len: int = 16) -> None:
+    rollout_dir.mkdir(parents=True, exist_ok=True)
+    path = rollout_dir / "episode_000000.npz"
+    if path.exists():
+        return
+
+    steps = 4
+    states = np.zeros((steps, action_dim), dtype=np.float32)
+    actions = np.zeros((steps, action_dim), dtype=np.float32)
+    rewards = np.linspace(0.0, 1.0, steps, dtype=np.float32)
+    action_tokens = np.zeros((1, token_len), dtype=np.int32)
+    old_logprobs = np.full((1, token_len), -8.0, dtype=np.float32)
+    action_token_mask = np.ones((1, token_len), dtype=np.bool_)
+    meta = {
+        "episode": 0,
+        "task": "LeIsaac-SO101-LiftCube-v0",
+        "prompt": "Lift the red cube up.",
+        "steps": steps,
+        "return": float(np.sum(rewards)),
+        "smoke": True,
+    }
+    np.savez_compressed(
+        path,
+        states=states,
+        actions_lerobot=actions,
+        rewards=rewards,
+        terminations=np.asarray([False, False, False, True], dtype=np.bool_),
+        truncations=np.zeros((steps,), dtype=np.bool_),
+        chunk_start_steps=np.asarray([0], dtype=np.int32),
+        chunk_lengths=np.asarray([steps], dtype=np.int32),
+        action_tokens=action_tokens,
+        action_token_logprobs=old_logprobs,
+        action_token_mask=action_token_mask,
+        meta_json=np.asarray(json.dumps(meta), dtype=np.str_),
+    )
+
+
+def _array(data: np.lib.npyio.NpzFile, *names: str) -> np.ndarray:
+    for name in names:
+        if name in data:
+            value = np.asarray(data[name])
+            if value.ndim == 3 and value.shape[1] == 1:
+                value = value[:, 0]
+            return value
+    raise KeyError(f"Missing any of {names} in rollout file.")
+
+
+def _optional_images(data: np.lib.npyio.NpzFile, name: str, step: int) -> np.ndarray:
+    if name not in data:
+        return np.zeros(IMAGE_SHAPE, dtype=np.uint8)
+    return np.asarray(data[name][step], dtype=np.uint8)
+
+
+def normalize_advantages(examples: list[PPOExample]) -> list[PPOExample]:
+    advantages = np.asarray([example.advantage for example in examples], dtype=np.float32)
+    if float(np.std(advantages)) > 1.0e-6:
+        advantages = (advantages - float(np.mean(advantages))) / (float(np.std(advantages)) + 1.0e-6)
+    elif float(np.max(np.abs(advantages))) > 1.0e-6:
+        advantages = advantages / (float(np.max(np.abs(advantages))) + 1.0e-6)
+
+    return [
+        dataclasses.replace(example, advantage=float(advantage))
+        for example, advantage in zip(examples, advantages, strict=True)
+    ]
+
+
+def load_examples(rollout_dir: Path, *, gamma: float, max_examples: int) -> list[PPOExample]:
+    examples: list[PPOExample] = []
+    for path in sorted(rollout_dir.glob("episode_*.npz")):
+        with np.load(path, allow_pickle=True) as data:
+            states = np.asarray(data["states"], dtype=np.float32)
+            rewards = np.asarray(data["rewards"], dtype=np.float32)
+            returns = discounted_returns(rewards, gamma)
+            prompt = rollout_prompt(data)
+            action_tokens = _array(data, "action_tokens", "tokens").astype(np.int32)
+            old_logprobs = _array(data, "action_token_logprobs", "token_logprobs", "logprobs").astype(np.float32)
+            if "action_token_mask" in data:
+                token_mask = np.asarray(data["action_token_mask"], dtype=np.bool_)
+            else:
+                token_mask = np.ones_like(action_tokens, dtype=np.bool_)
+            if token_mask.ndim == 3 and token_mask.shape[1] == 1:
+                token_mask = token_mask[:, 0]
+
+            if "chunk_start_steps" in data:
+                chunk_starts = np.asarray(data["chunk_start_steps"], dtype=np.int32)
+            else:
+                chunk_starts = np.arange(len(action_tokens), dtype=np.int32)
+
+            chunks = min(len(chunk_starts), len(action_tokens), len(old_logprobs), len(token_mask))
+            for chunk_index in range(chunks):
+                step = int(chunk_starts[chunk_index])
+                if step >= len(states) or step >= len(returns):
+                    continue
+                examples.append(
+                    PPOExample(
+                        state=states[step],
+                        action_tokens=action_tokens[chunk_index],
+                        old_token_logprobs=old_logprobs[chunk_index],
+                        action_token_mask=token_mask[chunk_index],
+                        advantage=float(returns[step]),
+                        prompt=prompt,
+                        front_image=_optional_images(data, "front_images", step),
+                        wrist_image=_optional_images(data, "wrist_images", step),
+                    )
+                )
+                if len(examples) >= max_examples:
+                    return normalize_advantages(examples)
+    return normalize_advantages(examples)
+
+
+def make_transform(train_config: _config.TrainConfig) -> _transforms.DataTransformFn:
+    data_config = train_config.data.create(train_config.assets_dirs, train_config.model)
+    return _transforms.compose(
+        [
+            *data_config.data_transforms.inputs,
+            _transforms.Normalize(data_config.norm_stats, use_quantiles=data_config.use_quantile_norm),
+            *data_config.model_transforms.inputs,
+        ]
+    )
+
+
+def transform_example(transform: _transforms.DataTransformFn, example: PPOExample) -> dict[str, Any]:
+    return transform(
+        {
+            "observation/image": example.front_image,
+            "observation/wrist_image": example.wrist_image,
+            "observation/state": example.state,
+            "prompt": example.prompt,
+        }
+    )
+
+
+def stack_batch(items: list[dict[str, Any]]) -> dict[str, Any]:
+    return jax.tree.map(lambda *xs: np.stack(xs), *items)
+
+
+def sample_batch(
+    rng: np.random.Generator,
+    examples: list[PPOExample],
+    transform: _transforms.DataTransformFn,
+    batch_size: int,
+) -> tuple[_model.Observation, jnp.ndarray, jnp.ndarray, jnp.ndarray, jnp.ndarray]:
+    indices = rng.integers(0, len(examples), size=batch_size)
+    selected = [examples[int(index)] for index in indices]
+    raw_batch = [transform_example(transform, example) for example in selected]
+    batch = stack_batch(raw_batch)
+    observation = _model.Observation.from_dict(jax.tree.map(jnp.asarray, batch))
+    return (
+        observation,
+        jnp.asarray(np.stack([example.action_tokens for example in selected]), dtype=jnp.int32),
+        jnp.asarray(np.stack([example.old_token_logprobs for example in selected]), dtype=jnp.float32),
+        jnp.asarray(np.stack([example.action_token_mask for example in selected]), dtype=jnp.float32),
+        jnp.asarray([example.advantage for example in selected], dtype=jnp.float32),
+    )
+
+
+def init_state(
+    train_config: _config.TrainConfig,
+    rng: at.KeyArrayLike,
+    *,
+    learning_rate: float,
+    init_checkpoint: str | None,
+    init_random: bool,
+) -> training_utils.TrainState:
+    model = train_config.model.create(rng)
+    graphdef, params = nnx.split(model)
+    if not init_random:
+        if init_checkpoint is None:
+            LOGGER.info("Loading initial params from config weight_loader")
+            restored = train_config.weight_loader.load(params.to_pure_dict())
+        else:
+            params_path = init_checkpoint if str(init_checkpoint).endswith("/params") else f"{init_checkpoint}/params"
+            LOGGER.info("Loading initial params from %s", params_path)
+            restored = _model.restore_params(download.maybe_download(params_path), dtype=jnp.bfloat16)
+        params.replace_by_pure_dict(restored)
+
+    tx = optax.chain(optax.clip_by_global_norm(1.0), optax.adamw(learning_rate, weight_decay=1e-10))
+    return training_utils.TrainState(
+        step=0,
+        params=params,
+        model_def=graphdef,
+        tx=tx,
+        opt_state=tx.init(params.filter(train_config.trainable_filter)),
+        ema_decay=None,
+        ema_params=None,
+    )
+
+
+@functools.partial(jax.jit, static_argnums=0)
+def train_step(
+    train_config: _config.TrainConfig,
+    state: training_utils.TrainState,
+    observation: _model.Observation,
+    action_tokens: jnp.ndarray,
+    old_token_logprobs: jnp.ndarray,
+    action_token_mask: jnp.ndarray,
+    advantages: jnp.ndarray,
+    clip_epsilon: float,
+    kl_coef: float,
+    logprob_temperature: float,
+) -> tuple[training_utils.TrainState, dict[str, jnp.ndarray]]:
+    model = nnx.merge(state.model_def, state.params)
+    model.train()
+
+    def loss_fn(model: _model.BaseModel) -> jnp.ndarray:
+        new_token_logprobs = model.score_action_tokens(
+            observation,
+            action_tokens,
+            temperature=logprob_temperature,
+        )
+        token_mask = jax.lax.stop_gradient(action_token_mask)
+        new_logprob = jnp.sum(new_token_logprobs * token_mask, axis=-1)
+        old_logprob = jnp.sum(jax.lax.stop_gradient(old_token_logprobs) * token_mask, axis=-1)
+        advantage = jax.lax.stop_gradient(advantages)
+
+        log_ratio = jnp.clip(new_logprob - old_logprob, -20.0, 20.0)
+        ratio = jnp.exp(log_ratio)
+        unclipped = ratio * advantage
+        clipped = jnp.clip(ratio, 1.0 - clip_epsilon, 1.0 + clip_epsilon) * advantage
+        policy_loss = -jnp.mean(jnp.minimum(unclipped, clipped))
+        approx_kl = 0.5 * jnp.mean(jnp.square(new_logprob - old_logprob))
+        return policy_loss + kl_coef * approx_kl
+
+    diff_state = nnx.DiffState(0, train_config.trainable_filter)
+    loss, grads = nnx.value_and_grad(loss_fn, argnums=diff_state)(model)
+    params = state.params.filter(train_config.trainable_filter)
+    updates, opt_state = state.tx.update(grads, state.opt_state, params)
+    new_params = optax.apply_updates(params, updates)
+    nnx.update(model, new_params)
+    next_state = dataclasses.replace(
+        state,
+        step=state.step + 1,
+        params=nnx.state(model),
+        opt_state=opt_state,
+    )
+    return next_state, {"loss": loss, "grad_norm": optax.global_norm(grads)}
+
+
+def save_checkpoint(save_dir: Path, state: training_utils.TrainState, train_config: _config.TrainConfig) -> None:
+    params_dir = save_dir / "params"
+    params_dir.parent.mkdir(parents=True, exist_ok=True)
+    with ocp.PyTreeCheckpointer() as checkpointer:
+        checkpointer.save(params_dir, {"params": state.params})
+    data_config = train_config.data.create(train_config.assets_dirs, train_config.model)
+    if data_config.norm_stats is not None and data_config.asset_id is not None:
+        _normalize.save(save_dir / "assets" / data_config.asset_id, data_config.norm_stats)
+
+
+def main() -> None:
+    logging.basicConfig(level=logging.INFO, force=True)
+    args = parse_args()
+    train_config = _config.get_config(args.config)
+
+    if args.make_smoke_rollout:
+        make_smoke_rollout(args.rollout_dir, action_dim=train_config.model.action_dim)
+
+    examples = load_examples(args.rollout_dir, gamma=args.gamma, max_examples=args.max_examples)
+    if not examples:
+        raise ValueError(f"No PPO rollout examples found in {args.rollout_dir}")
+
+    transform = make_transform(train_config)
+    np_rng = np.random.default_rng(args.seed)
+    observation, action_tokens, old_logprobs, token_mask, advantages = sample_batch(
+        np_rng, examples, transform, args.batch_size
+    )
+    LOGGER.info(
+        "Loaded %d PPO chunks. Batch: state=%s action_tokens=%s advantage=%s",
+        len(examples),
+        observation.state.shape,
+        action_tokens.shape,
+        np.asarray(advantages),
+    )
+
+    if args.dry_run_data:
+        return
+
+    rng = jax.random.key(args.seed)
+    state = init_state(
+        train_config,
+        rng,
+        learning_rate=args.learning_rate,
+        init_checkpoint=args.init_checkpoint,
+        init_random=args.init_random,
+    )
+
+    for step in tqdm.tqdm(range(args.num_train_steps)):
+        observation, action_tokens, old_logprobs, token_mask, advantages = sample_batch(
+            np_rng, examples, transform, args.batch_size
+        )
+        state, info = train_step(
+            train_config,
+            state,
+            observation,
+            action_tokens,
+            old_logprobs,
+            token_mask,
+            advantages,
+            args.clip_epsilon,
+            args.kl_coef,
+            args.logprob_temperature,
+        )
+        info = jax.device_get(info)
+        LOGGER.info("step=%d loss=%.6f grad_norm=%.6f", step, float(info["loss"]), float(info["grad_norm"]))
+
+    if args.save_dir is not None:
+        save_checkpoint(args.save_dir, state, train_config)
+        LOGGER.info("Saved params to %s", args.save_dir / "params")
+
+
+if __name__ == "__main__":
+    main()
