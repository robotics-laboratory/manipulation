+"""Reward-weighted online rollout finetuning for pi0-FAST.
+
+This is a small smokeable learner for LeIsaac online RL experiments. It reads
+rollouts produced by ``manipulation/scripts/leisaac/scripts/training/online_pi_fast_so101.py``
+and updates pi0-FAST by weighting the action-token negative log likelihood by
+episode returns. It is not a full PPO implementation, but it exercises the
+online data path and provides a stable first RL-style update without a BC stage.
+"""
+
+from __future__ import annotations
+
+import argparse
+import dataclasses
+import functools
+import json
+import logging
+from pathlib import Path
+from typing import Any
+
+import flax.nnx as nnx
+import jax
+import jax.numpy as jnp
+import numpy as np
+import optax
+import orbax.checkpoint as ocp
+import tqdm_loggable.auto as tqdm
+
+import openpi.models.model as _model
+import openpi.shared.array_typing as at
+import openpi.shared.download as download
+import openpi.transforms as _transforms
+import openpi.training.config as _config
+import openpi.training.utils as training_utils
+
+
+LOGGER = logging.getLogger("openpi.rollout_rl")
+IMAGE_SHAPE = (224, 224, 3)
+
+
+@dataclasses.dataclass(frozen=True)
+class Example:
+    state: np.ndarray
+    action_chunk: np.ndarray
+    reward_to_go: float
+    prompt: str
+    front_image: np.ndarray
+    wrist_image: np.ndarray
+
+
+def parse_args() -> argparse.Namespace:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--config", default="pi0_fast_so101_lift_cube")
+    parser.add_argument("--rollout_dir", type=Path, required=True)
+    parser.add_argument("--init_checkpoint", default=None)
+    parser.add_argument("--save_dir", type=Path, default=None)
+    parser.add_argument("--num_train_steps", type=int, default=1)
+    parser.add_argument("--batch_size", type=int, default=1)
+    parser.add_argument("--learning_rate", type=float, default=1e-6)
+    parser.add_argument("--seed", type=int, default=0)
+    parser.add_argument("--gamma", type=float, default=0.99)
+    parser.add_argument("--max_examples", type=int, default=128)
+    parser.add_argument("--make_smoke_rollout", action="store_true")
+    parser.add_argument(
+        "--dry_run_data",
+        action="store_true",
+        help="Only build and print a transformed batch; do not initialize the model.",
+    )
+    parser.add_argument(
+        "--init_random",
+        action="store_true",
+        help="Skip checkpoint loading. Useful only for pipeline smoke tests.",
+    )
+    return parser.parse_args()
+
+
+def make_smoke_rollout(rollout_dir: Path, *, action_horizon: int, action_dim: int) -> None:
+    rollout_dir.mkdir(parents=True, exist_ok=True)
+    path = rollout_dir / "episode_000000.npz"
+    if path.exists():
+        return
+
+    steps = max(action_horizon, 4)
+    states = np.zeros((steps, action_dim), dtype=np.float32)
+    actions = np.zeros((steps, action_dim), dtype=np.float32)
+    actions[:, 5] = 80.0
+    rewards = np.linspace(0.0, 1.0, steps, dtype=np.float32)
+    terminations = np.zeros((steps,), dtype=np.bool_)
+    terminations[-1] = True
+    truncations = np.zeros((steps,), dtype=np.bool_)
+    meta = {
+        "episode": 0,
+        "task": "LeIsaac-SO101-LiftCube-v0",
+        "prompt": "Lift the red cube up.",
+        "steps": int(steps),
+        "return": float(np.sum(rewards)),
+        "success": True,
+        "timeout": False,
+        "smoke": True,
+    }
+    np.savez_compressed(
+        path,
+        states=states,
+        actions_lerobot=actions,
+        rewards=rewards,
+        terminations=terminations,
+        truncations=truncations,
+        meta_json=np.asarray(json.dumps(meta), dtype=np.str_),
+    )
+
+
+def discounted_returns(rewards: np.ndarray, gamma: float) -> np.ndarray:
+    returns = np.zeros_like(rewards, dtype=np.float32)
+    running = 0.0
+    for index in range(len(rewards) - 1, -1, -1):
+        running = float(rewards[index]) + gamma * running
+        returns[index] = running
+    return returns
+
+
+def action_chunk(actions: np.ndarray, start: int, horizon: int, action_dim: int) -> np.ndarray:
+    chunk = np.zeros((horizon, action_dim), dtype=np.float32)
+    available = actions[start : start + horizon, :action_dim]
+    chunk[: len(available)] = available
+    if 0 < len(available) < horizon:
+        chunk[len(available) :] = available[-1]
+    return chunk
+
+
+def rollout_prompt(data: np.lib.npyio.NpzFile) -> str:
+    if "meta_json" not in data:
+        return "Lift the red cube up."
+    meta = json.loads(str(data["meta_json"].item()))
+    return str(meta.get("prompt") or "Lift the red cube up.")
+
+
+def load_examples(rollout_dir: Path, *, action_horizon: int, action_dim: int, gamma: float, max_examples: int) -> list[Example]:
+    examples: list[Example] = []
+    for path in sorted(rollout_dir.glob("episode_*.npz")):
+        with np.load(path, allow_pickle=True) as data:
+            states = np.asarray(data["states"], dtype=np.float32)
+            actions = np.asarray(data["actions_lerobot"], dtype=np.float32)
+            rewards = np.asarray(data["rewards"], dtype=np.float32)
+            prompt = rollout_prompt(data)
+            returns = discounted_returns(rewards, gamma)
+            front_images = data["front_images"] if "front_images" in data else None
+            wrist_images = data["wrist_images"] if "wrist_images" in data else None
+
+            steps = min(len(states), len(actions), len(rewards))
+            for step in range(steps):
+                front = (
+                    np.asarray(front_images[step], dtype=np.uint8)
+                    if front_images is not None
+                    else np.zeros(IMAGE_SHAPE, dtype=np.uint8)
+                )
+                wrist = (
+                    np.asarray(wrist_images[step], dtype=np.uint8)
+                    if wrist_images is not None
+                    else np.zeros(IMAGE_SHAPE, dtype=np.uint8)
+                )
+                examples.append(
+                    Example(
+                        state=states[step, :action_dim],
+                        action_chunk=action_chunk(actions, step, action_horizon, action_dim),
+                        reward_to_go=float(returns[step]),
+                        prompt=prompt,
+                        front_image=front,
+                        wrist_image=wrist,
+                    )
+                )
+                if len(examples) >= max_examples:
+                    return examples
+    return examples
+
+
+def make_transform(train_config: _config.TrainConfig) -> _transforms.DataTransformFn:
+    data_config = train_config.data.create(train_config.assets_dirs, train_config.model)
+    return _transforms.compose(
+        [
+            *data_config.data_transforms.inputs,
+            _transforms.Normalize(data_config.norm_stats, use_quantiles=data_config.use_quantile_norm),
+            *data_config.model_transforms.inputs,
+        ]
+    )
+
+
+def transform_example(transform: _transforms.DataTransformFn, example: Example) -> dict[str, Any]:
+    return transform(
+        {
+            "observation/image": example.front_image,
+            "observation/wrist_image": example.wrist_image,
+            "observation/state": example.state,
+            "actions": example.action_chunk,
+            "prompt": example.prompt,
+        }
+    )
+
+
+def stack_batch(items: list[dict[str, Any]]) -> dict[str, Any]:
+    return jax.tree.map(lambda *xs: np.stack(xs), *items)
+
+
+def sample_batch(
+    rng: np.random.Generator,
+    examples: list[Example],
+    transform: _transforms.DataTransformFn,
+    batch_size: int,
+) -> tuple[_model.Observation, jnp.ndarray, jnp.ndarray]:
+    indices = rng.integers(0, len(examples), size=batch_size)
+    raw_batch = [transform_example(transform, examples[int(index)]) for index in indices]
+    weights = np.asarray([examples[int(index)].reward_to_go for index in indices], dtype=np.float32)
+    if float(np.std(weights)) > 1e-6:
+        weights = (weights - float(np.mean(weights))) / (float(np.std(weights)) + 1e-6)
+    elif float(np.max(np.abs(weights))) > 1e-6:
+        weights = weights / (float(np.max(np.abs(weights))) + 1e-6)
+    else:
+        weights = np.ones_like(weights)
+
+    batch = stack_batch(raw_batch)
+    observation = _model.Observation.from_dict(jax.tree.map(jnp.asarray, batch))
+    actions = jnp.asarray(batch["actions"], dtype=jnp.float32)
+    return observation, actions, jnp.asarray(weights, dtype=jnp.float32)
+
+
+def init_state(
+    train_config: _config.TrainConfig,
+    rng: at.KeyArrayLike,
+    *,
+    learning_rate: float,
+    init_checkpoint: str | None,
+    init_random: bool,
+) -> training_utils.TrainState:
+    model = train_config.model.create(rng)
+    graphdef, params = nnx.split(model)
+    if not init_random:
+        if init_checkpoint is None:
+            LOGGER.info("Loading initial params from config weight_loader")
+            restored = train_config.weight_loader.load(params.to_pure_dict())
+        else:
+            params_path = init_checkpoint if str(init_checkpoint).endswith("/params") else f"{init_checkpoint}/params"
+            LOGGER.info("Loading initial params from %s", params_path)
+            restored = _model.restore_params(download.maybe_download(params_path), dtype=jnp.bfloat16)
+        params.replace_by_pure_dict(restored)
+
+    tx = optax.chain(optax.clip_by_global_norm(1.0), optax.adamw(learning_rate, weight_decay=1e-10))
+    return training_utils.TrainState(
+        step=0,
+        params=params,
+        model_def=graphdef,
+        tx=tx,
+        opt_state=tx.init(params.filter(train_config.trainable_filter)),
+        ema_decay=None,
+        ema_params=None,
+    )
+
+
+@functools.partial(jax.jit, static_argnums=0)
+def train_step(
+    train_config: _config.TrainConfig,
+    rng: at.KeyArrayLike,
+    state: training_utils.TrainState,
+    observation: _model.Observation,
+    actions: jnp.ndarray,
+    weights: jnp.ndarray,
+) -> tuple[training_utils.TrainState, dict[str, jnp.ndarray]]:
+    model = nnx.merge(state.model_def, state.params)
+    model.train()
+
+    def loss_fn(model: _model.BaseModel) -> jnp.ndarray:
+        per_example_loss = model.compute_loss(rng, observation, actions, train=True)
+        return jnp.mean(per_example_loss * jax.lax.stop_gradient(weights))
+
+    diff_state = nnx.DiffState(0, train_config.trainable_filter)
+    loss, grads = nnx.value_and_grad(loss_fn, argnums=diff_state)(model)
+    params = state.params.filter(train_config.trainable_filter)
+    updates, opt_state = state.tx.update(grads, state.opt_state, params)
+    new_params = optax.apply_updates(params, updates)
+    nnx.update(model, new_params)
+    next_state = dataclasses.replace(
+        state,
+        step=state.step + 1,
+        params=nnx.state(model),
+        opt_state=opt_state,
+    )
+    return next_state, {"loss": loss, "grad_norm": optax.global_norm(grads)}
+
+
+def save_params(save_dir: Path, state: training_utils.TrainState) -> None:
+    params_dir = save_dir / "params"
+    params_dir.parent.mkdir(parents=True, exist_ok=True)
+    with ocp.PyTreeCheckpointer() as checkpointer:
+        checkpointer.save(params_dir, {"params": state.params})
+
+
+def main() -> None:
+    logging.basicConfig(level=logging.INFO, force=True)
+    args = parse_args()
+    train_config = _config.get_config(args.config)
+
+    if args.make_smoke_rollout:
+        make_smoke_rollout(
+            args.rollout_dir,
+            action_horizon=train_config.model.action_horizon,
+            action_dim=train_config.model.action_dim,
+        )
+
+    examples = load_examples(
+        args.rollout_dir,
+        action_horizon=train_config.model.action_horizon,
+        action_dim=train_config.model.action_dim,
+        gamma=args.gamma,
+        max_examples=args.max_examples,
+    )
+    if not examples:
+        raise ValueError(f"No rollout examples found in {args.rollout_dir}")
+
+    transform = make_transform(train_config)
+    np_rng = np.random.default_rng(args.seed)
+    observation, actions, weights = sample_batch(np_rng, examples, transform, args.batch_size)
+    LOGGER.info(
+        "Loaded %d examples. Batch: state=%s actions=%s tokens=%s weights=%s",
+        len(examples),
+        observation.state.shape,
+        actions.shape,
+        observation.tokenized_prompt.shape if observation.tokenized_prompt is not None else None,
+        np.asarray(weights),
+    )
+
+    if args.dry_run_data:
+        return
+
+    rng = jax.random.key(args.seed)
+    init_rng, train_rng = jax.random.split(rng)
+    state = init_state(
+        train_config,
+        init_rng,
+        learning_rate=args.learning_rate,
+        init_checkpoint=args.init_checkpoint,
+        init_random=args.init_random,
+    )
+
+    for step in tqdm.tqdm(range(args.num_train_steps)):
+        observation, actions, weights = sample_batch(np_rng, examples, transform, args.batch_size)
+        step_rng = jax.random.fold_in(train_rng, step)
+        state, info = train_step(train_config, step_rng, state, observation, actions, weights)
+        info = jax.device_get(info)
+        LOGGER.info("step=%d loss=%.6f grad_norm=%.6f", step, float(info["loss"]), float(info["grad_norm"]))
+
+    if args.save_dir is not None:
+        save_params(args.save_dir, state)
+        LOGGER.info("Saved params to %s", args.save_dir / "params")
+
+
+if __name__ == "__main__":
+    main()
